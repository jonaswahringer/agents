#!/usr/bin/env bash

# macOS still ships Bash 3.2, where `set -u` treats an empty array as an
# unbound variable. The installer deliberately supports that shell.
set -eo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_DIRECTORY="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SCRIPT_PATH="$LINK_TARGET"
  else
    SCRIPT_PATH="$SCRIPT_DIRECTORY/$LINK_TARGET"
  fi
done
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CONFIG_DIR="${AGENTS_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/agents}"
PROFILE_DIR="$CONFIG_DIR/profile"
SELECTED_FILE="$CONFIG_DIR/selected-skills"
GLOBAL_STATE_FILE="$CONFIG_DIR/global-config"
AGENTS_DIR="${AGENTS_HOME:-$HOME/.agents}"
BIN_DIR="${AGENTS_BIN_DIR:-$HOME/.local/bin}"
USAGE_NAME="${AGENTS_USAGE_NAME:-usage}"
USAGE_FALLBACK_NAME="aiusage"
CLAUDE_DIR="${CLAUDE_HOME:-$HOME/.claude}"
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
FORCE=0
NON_INTERACTIVE=0
CONFIG_SELECTED=1
SELECTED=()
SKILLS=()
CATEGORIES=()
ROW_KIND=()
ROW_VALUE=()
SHOW_SKILL_PROGRESS=0

usage() {
  cat <<'EOF'
agents manages shared instructions and skills for coding agents.

Usage:
  agents update              Update the tool and selected skills
  agents update --skills     Update, then open the skill menu
  agents configure           Edit the saved global configuration
  agents source              Show where agents runs from and how global config links
  agents skills              Choose installed skills
  agents skill               Alias for agents skills
  agents skills add NAME     Add one skill without changing other selections
  agents skills sync FOLDER  Merge copied skills from their upstream repository
  agents skills source       Show the skills folder and each skill's links
  agents doctor              Check the current installation
  agents doctor --verbose    Check, then show every path and link
  agents help

Skills are grouped in folders by who wrote them, such as jonasw or mattp.

Installer options:
  --all                      Select global config and every skill
  --skills NAME,NAME         Select skills, folders, or folder/name
  --no-config                Do not create global config
  --non-interactive          Do not open the keyboard menu
  --force                    Back up and replace conflicting files

Environment:
  AGENTS_USAGE_NAME          Name for the quota command (default: usage)
EOF
}

die() {
  echo "agents: $*" >&2
  exit 1
}

validate_skill_metadata() {
  local path="$1" expected="$2" error
  if ! error="$(awk -v expected="$expected" '
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }
    function valid_hex(value, start, count, i, character) {
      for (i = start; i < start + count; i++) {
        character = substr(value, i, 1)
        if (character !~ /^[0-9a-fA-F]$/) return 0
      }
      return 1
    }
    function valid_double_quoted(value, i, character, escape, count, rest) {
      if (length(value) < 2) return 0
      for (i = 2; i <= length(value); i++) {
        character = substr(value, i, 1)
        if (character == "\"") {
          if (i == 2) return 0
          rest = substr(value, i + 1)
          return rest == "" || rest ~ /^[[:space:]]+#/
        }
        if (character == "\\") {
          i++
          if (i > length(value)) return 0
          escape = substr(value, i, 1)
          if (escape ~ /^[0abtnvfre "\/\\N_LP]$/) continue
          if (escape == "x") count = 2
          else if (escape == "u") count = 4
          else if (escape == "U") count = 8
          else return 0
          if (!valid_hex(value, i + 1, count)) return 0
          i += count
        }
      }
      return 0
    }
    function valid_single_quoted(value, i, rest) {
      if (length(value) < 2) return 0
      for (i = 2; i <= length(value); i++) {
        if (substr(value, i, 1) == "\047") {
          if (substr(value, i + 1, 1) == "\047") {
            i++
          } else {
            if (i == 2) return 0
            rest = substr(value, i + 1)
            return rest == "" || rest ~ /^[[:space:]]+#/
          }
        }
      }
      return 0
    }
    function strip_plain_comment(value, i) {
      for (i = 1; i <= length(value); i++) {
        if (substr(value, i, 1) == "#" && (i == 1 || substr(value, i - 1, 1) ~ /[[:space:]]/)) {
          return trim(substr(value, 1, i - 1))
        }
      }
      return value
    }
    function valid_description(value, first, plain) {
      if (value ~ /^[>|][+-]?$/) return block_content
      first = substr(value, 1, 1)
      if (first == "\"") return valid_double_quoted(value)
      if (first == "\047") return valid_single_quoted(value)
      plain = strip_plain_comment(value)
      if (plain ~ /^[>|][+-]?$/) return block_content
      first = substr(plain, 1, 1)
      if (plain == "" || first == "[" || first == "{") return 0
      if (plain ~ /:[[:space:]]/) return 0
      return 1
    }
    NR == 1 {
      if ($0 != "---") problem = "front matter must start with ---"
      next
    }
    !closed && $0 == "---" {
      closed = 1
      next
    }
    !closed && description_block && /^[[:space:]]+/ {
      block_line = trim($0)
      if (block_line != "") block_content = 1
      next
    }
    !closed && /^name:[[:space:]]*/ {
      description_block = 0
      name_count++
      name = $0
      sub(/^name:[[:space:]]*/, "", name)
      name = trim(name)
      next
    }
    !closed && /^description:[[:space:]]*/ {
      description_count++
      description = $0
      sub(/^description:[[:space:]]*/, "", description)
      description = trim(description)
      if (strip_plain_comment(description) ~ /^[>|][+-]?$/) description_block = 1
      next
    }
    !closed && /^[^[:space:]]/ {
      description_block = 0
    }
    END {
      if (problem != "") print problem
      else if (!closed) print "front matter must end with ---"
      else if (name_count != 1) print "front matter needs one name field"
      else if (name != expected) print "name must match its directory: " expected
      else if (length(name) > 64 || name !~ /^[a-z0-9][a-z0-9-]*$/) print "name must use at most 64 lowercase letters, numbers, or hyphens"
      else if (description_count != 1 || description == "" || description == "\"\"" || description == "\047\047") print "front matter needs one non-empty description field"
      else if (!valid_description(description)) print "description must be a valid non-empty string"
    }
  ' "$path")"; then
    echo "agents: could not parse skill metadata in $path" >&2
    return 1
  fi
  if [[ -n "$error" ]]; then
    echo "agents: invalid skill metadata in $path: $error" >&2
    return 1
  fi
}

# Skills live at skills/<folder>/<name>/SKILL.md, where the folder names whoever
# wrote them. A selection is always stored as "folder/name". Folders are read from
# disk, so adding one to the repository is enough to make it appear in the menu.
discover_skills() {
  SKILLS=()
  CATEGORIES=()
  local category_directory skill_directory category found
  for category_directory in "$ROOT"/skills/*; do
    [[ -d "$category_directory" ]] || continue
    category="$(basename "$category_directory")"
    found=0
    for skill_directory in "$category_directory"/*; do
      if [[ -f "$skill_directory/SKILL.md" ]]; then
        validate_skill_metadata "$skill_directory/SKILL.md" "$(basename "$skill_directory")" || die "fix the skill metadata before installing"
        SKILLS+=("$category/$(basename "$skill_directory")")
        found=1
      fi
    done
    if [[ $found -eq 1 ]]; then
      CATEGORIES+=("$category")
    fi
  done
}

is_category() {
  local wanted="$1" category
  for category in "${CATEGORIES[@]}"; do
    [[ "$category" == "$wanted" ]] && return 0
  done
  return 1
}

category_total() {
  local category="$1" skill count=0
  for skill in "${SKILLS[@]}"; do
    [[ "${skill%%/*}" == "$category" ]] && count=$((count + 1))
  done
  printf '%s\n' "$count"
}

category_selected_count() {
  local category="$1" skill count=0
  for skill in "${SELECTED[@]}"; do
    [[ "${skill%%/*}" == "$category" ]] && count=$((count + 1))
  done
  printf '%s\n' "$count"
}

category_fully_selected() {
  local category="$1" total
  total="$(category_total "$category")"
  [[ $total -gt 0 && "$(category_selected_count "$category")" -eq $total ]]
}

# Accepts "folder/name", a bare name, or a name saved before skills had folders.
# Exit 1 means no such skill, exit 2 means the bare name is in several folders.
resolve_skill() {
  local wanted="$1" skill matches=""
  case "$wanted" in
    nice-to-read|jonasw/nice-to-read) wanted="jonasw/nice" ;;
    minj/c4-explorer) wanted="jonasw/c4-explorer" ;;
  esac
  for skill in "${SKILLS[@]}"; do
    if [[ "$skill" == "$wanted" || "${skill##*/}" == "$wanted" ]]; then
      matches="$matches $skill"
    fi
  done
  set -- $matches
  if [[ $# -eq 0 ]]; then
    return 1
  fi
  if [[ $# -eq 1 ]]; then
    printf '%s\n' "$1"
    return 0
  fi
  for skill in "$@"; do
    if [[ "$skill" == "$wanted" ]]; then
      printf '%s\n' "$skill"
      return 0
    fi
  done
  return 2
}

has_selected() {
  local wanted="$1" item
  for item in "${SELECTED[@]}"; do
    [[ "$item" == "$wanted" ]] && return 0
  done
  return 1
}

add_selected() {
  has_selected "$1" || SELECTED+=("$1")
}

ensure_global_response_skill() {
  if [[ $CONFIG_SELECTED -eq 1 ]]; then
    add_selected "jonasw/nice"
  fi
}

remove_selected() {
  local wanted="$1" item
  local next=()
  for item in "${SELECTED[@]}"; do
    [[ "$item" == "$wanted" ]] || next+=("$item")
  done
  SELECTED=("${next[@]}")
}

select_all_skills() {
  SELECTED=()
  local skill
  for skill in "${SKILLS[@]}"; do
    SELECTED+=("$skill")
  done
}

select_category() {
  local category="$1" skill
  for skill in "${SKILLS[@]}"; do
    if [[ "${skill%%/*}" == "$category" ]]; then
      add_selected "$skill"
    fi
  done
  return 0
}

deselect_category() {
  local category="$1" skill
  for skill in "${SKILLS[@]}"; do
    if [[ "${skill%%/*}" == "$category" ]]; then
      remove_selected "$skill"
    fi
  done
  return 0
}

selected_installs_name() {
  local wanted="$1" skill
  for skill in "${SELECTED[@]}"; do
    [[ "${skill##*/}" == "$wanted" ]] && return 0
  done
  return 1
}

load_selected() {
  SELECTED=()
  [[ -f "$SELECTED_FILE" ]] || return 0
  local entry resolved status
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    resolved="$(resolve_skill "$entry")" && status=0 || status=$?
    if [[ $status -eq 0 ]]; then
      add_selected "$resolved"
    elif [[ $status -eq 2 ]]; then
      echo "Saved skill '$entry' is now in more than one folder; select it again." >&2
    else
      echo "Saved skill '$entry' no longer exists; dropping it." >&2
    fi
  done < "$SELECTED_FILE"
}

load_global_state() {
  if [[ -f "$GLOBAL_STATE_FILE" && "$(<"$GLOBAL_STATE_FILE")" == "disabled" ]]; then
    CONFIG_SELECTED=0
  else
    CONFIG_SELECTED=1
  fi
}

save_global_state() {
  mkdir -p "$CONFIG_DIR"
  if [[ $CONFIG_SELECTED -eq 1 ]]; then
    printf 'enabled\n' > "$GLOBAL_STATE_FILE"
  else
    printf 'disabled\n' > "$GLOBAL_STATE_FILE"
  fi
}

save_selected() {
  mkdir -p "$CONFIG_DIR"
  : > "$SELECTED_FILE"
  local skill
  for skill in "${SELECTED[@]}"; do
    printf '%s\n' "$skill" >> "$SELECTED_FILE"
  done
}

all_skills_selected() {
  [[ ${#SKILLS[@]} -gt 0 && ${#SELECTED[@]} -eq ${#SKILLS[@]} ]]
}

build_rows() {
  local with_config="$1" category skill
  ROW_KIND=()
  ROW_VALUE=()
  if [[ "$with_config" == 1 ]]; then
    ROW_KIND+=("config"); ROW_VALUE+=("")
  fi
  ROW_KIND+=("all"); ROW_VALUE+=("")
  for category in "${CATEGORIES[@]}"; do
    ROW_KIND+=("category"); ROW_VALUE+=("$category")
    for skill in "${SKILLS[@]}"; do
      [[ "${skill%%/*}" == "$category" ]] || continue
      ROW_KIND+=("skill"); ROW_VALUE+=("$skill")
    done
  done
}

# A folder lists its skills while the cursor is inside it, so the menu stays short.
# A cursor of -1 opens every folder, which is what the menu snapshot needs.
row_visible() {
  local index="$1" cursor="$2"
  [[ "${ROW_KIND[$index]}" == "skill" ]] || return 0
  [[ $cursor -lt 0 ]] && return 0
  [[ "${ROW_VALUE[$index]%%/*}" == "${ROW_VALUE[$cursor]%%/*}" ]]
}

render_menu_row() {
  local index="$1" cursor="$2" details="${3:-0}" kind label mark level indent prefix suffix=""
  kind="${ROW_KIND[$index]}"
  case "$kind" in
    config)
      level=0; label="Global config"
      mark=" "; [[ $CONFIG_SELECTED -eq 1 ]] && mark="x"
      ;;
    all)
      level=0; label="Skills"
      [[ $details -eq 0 ]] || suffix="  ${#SELECTED[@]}/${#SKILLS[@]}"
      if all_skills_selected; then
        mark="x"
      elif [[ ${#SELECTED[@]} -gt 0 ]]; then
        mark="-"
      else
        mark=" "
      fi
      ;;
    category)
      level=1; label="${ROW_VALUE[$index]}"
      [[ $details -eq 0 ]] || suffix="  $(category_selected_count "$label")/$(category_total "$label")"
      if category_fully_selected "$label"; then
        mark="x"
      elif [[ "$(category_selected_count "$label")" -gt 0 ]]; then
        mark="-"
      else
        mark=" "
      fi
      ;;
    *)
      level=2; label="${ROW_VALUE[$index]##*/}"
      mark=" "; has_selected "${ROW_VALUE[$index]}" && mark="x"
      ;;
  esac
  indent=$((2 + level * 4))
  prefix="$(printf '%*s' "$indent" '')"
  [[ $cursor -eq $index ]] && prefix="$(printf '%*s> ' "$((indent - 2))" '')"
  if [[ $details -eq 1 ]]; then
    menu_line "$prefix[$mark] $label$suffix" "$([[ $cursor -eq $index ]] && printf active)"
  else
    printf '%s[%s] %s\n' "$prefix" "$mark" "$label"
  fi
}

render_menu() {
  local with_config="$1" cursor="$2" index=0
  build_rows "$with_config"
  while [[ $index -lt ${#ROW_KIND[@]} ]]; do
    if row_visible "$index" "$cursor"; then
      render_menu_row "$index" "$cursor"
    fi
    index=$((index + 1))
  done
}

# Skips rows hidden inside a closed folder. Visibility is judged from where the
# cursor is now, so leaving a folder lands on the next folder rather than its skills.
next_row() {
  local cursor="$1" delta="$2" count="${#ROW_KIND[@]}" next steps=0
  next="$cursor"
  while [[ $steps -lt $count ]]; do
    next=$(((next + delta + count) % count))
    steps=$((steps + 1))
    if row_visible "$next" "$cursor"; then
      break
    fi
  done
  printf '%s\n' "$next"
}

toggle_row() {
  # Assign in two steps: bash expands every argument of `local` before it assigns
  # any of them, so a second value cannot read the first one.
  local index="$1" value
  value="${ROW_VALUE[$index]}"
  case "${ROW_KIND[$index]}" in
    config) CONFIG_SELECTED=$((1 - CONFIG_SELECTED)) ;;
    all) if all_skills_selected; then SELECTED=(); else select_all_skills; fi ;;
    category)
      if category_fully_selected "$value"; then
        deselect_category "$value"
      else
        select_category "$value"
      fi
      ;;
    *)
      if has_selected "$value"; then
        remove_selected "$value"
      else
        add_selected "$value"
      fi
      ;;
  esac
}

# Tab moves between creators without walking through their skills. Letters cycle
# through creators with that initial; numbers select their position on disk.
creator_row() {
  local cursor="$1" direction="$2" initial="${3:-}" next steps=0
  next="$cursor"
  while [[ $steps -lt ${#ROW_KIND[@]} ]]; do
    next=$(((next + direction + ${#ROW_KIND[@]}) % ${#ROW_KIND[@]}))
    steps=$((steps + 1))
    [[ "${ROW_KIND[$next]}" == category ]] || continue
    if [[ -z "$initial" || "${ROW_VALUE[$next]:0:1}" == "$initial" ]]; then
      printf '%s\n' "$next"
      return
    fi
  done
  printf '%s\n' "$cursor"
}

menu_line() {
  local line="$1" style="${2:-}" escape=""
  if [[ ${#line} -gt $menu_columns ]]; then
    line="${line:0:$((menu_columns - 3))}..."
  fi
  if [[ -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
    case "$style" in
      active) escape=$'\033[7m' ;;
      heading) escape=$'\033[1m' ;;
      muted) escape=$'\033[2m' ;;
    esac
  fi
  printf '%s%s\033[0m\033[K\r\n' "$escape" "$line"
}

# Keep the active row visible, including inside folders taller than the terminal.
# Locals in interactive_menu hold the viewport and terminal size between frames.
render_menu_frame() {
  local cursor="$1" with_config="$2" index position=0 active=0 first last capacity shortcuts="  Creators" number=0 size
  local title=skills action=save
  local visible=()
  if [[ $with_config -eq 1 ]]; then title=setup; action=continue; fi
  size="$(stty size <&9)"
  read -r menu_lines menu_columns <<< "$size"
  [[ "$menu_lines" =~ ^[0-9]+$ && $menu_lines -gt 0 ]] || menu_lines=24
  [[ "$menu_columns" =~ ^[0-9]+$ && $menu_columns -gt 3 ]] || menu_columns=80
  for ((index = 0; index < ${#ROW_KIND[@]}; index++)); do
    if row_visible "$index" "$cursor"; then
      [[ $index -ne $cursor ]] || active="${#visible[@]}"
      visible+=("$index")
    fi
  done
  # Leave the last terminal line unused so its newline cannot scroll the frame.
  capacity=$((menu_lines - 9))
  [[ $capacity -gt 0 ]] || capacity=1
  [[ $menu_top -le $active ]] || menu_top="$active"
  [[ $active -lt $((menu_top + capacity)) ]] || menu_top=$((active - capacity + 1))
  if [[ $menu_top -gt 0 && $((menu_top + capacity)) -gt ${#visible[@]} ]]; then
    menu_top=$((${#visible[@]} - capacity))
    [[ $menu_top -ge 0 ]] || menu_top=0
  fi
  first="$menu_top"
  last=$((first + capacity))
  [[ $last -le ${#visible[@]} ]] || last="${#visible[@]}"
  for index in "${CATEGORIES[@]}"; do
    number=$((number + 1))
    if [[ $number -le 9 ]]; then
      shortcuts="$shortcuts  $number $index"
    else
      shortcuts="$shortcuts  $index"
    fi
  done

  printf '\033[H'
  menu_line "  agents / $title    ${#SELECTED[@]} of ${#SKILLS[@]} selected" heading
  menu_line "$shortcuts" muted
  menu_line ""
  for ((position = first; position < last; position++)); do
    render_menu_row "${visible[$position]}" "$cursor" 1
  done
  menu_line ""
  menu_line "  Rows $((first + 1))-$last of ${#visible[@]}" muted
  menu_line "  ↑↓ move  Space toggle  Enter $action"
  menu_line "  Tab/Shift+Tab creator  1-9/letter jump"
  menu_line "  q / Esc cancel" muted
  printf '\033[J'
}

menu_cleanup() {
  stty "$menu_terminal_state" <&9
  printf '\033[0m\033[?25h\033[?1049l' >&9
  exec 9>&-
}

interactive_menu() {
  local with_config="$1" cursor=0 key sequence part index number result=1 redraw=1
  local menu_top=0 menu_lines=24 menu_columns=80 menu_terminal_state
  [[ -r /dev/tty && -w /dev/tty ]] || die "interactive setup needs a terminal; use --all or --skills"
  build_rows "$with_config"
  [[ ${#ROW_KIND[@]} -gt 0 ]] || return 0

  exec 9<> /dev/tty
  menu_terminal_state="$(stty -g <&9)"
  trap 'menu_cleanup' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  trap 'redraw=1' WINCH
  stty -echo -icanon -isig -ixon min 1 time 0 <&9
  printf '\033[?1049h\033[?25l\033[2J' >&9
  while true; do
    if [[ $redraw -eq 1 ]]; then
      redraw=0
      render_menu_frame "$cursor" "$with_config" >&9
    fi
    # A timeout lets Bash 3.2 dispatch signals even while waiting on /dev/tty.
    if IFS= read -rsn1 -t 1 key <&9; then
      redraw=1
    else
      # Bash 3.2 also returns 1 for a timeout. A disconnected terminal exits
      # through the HUP trap; an idle terminal should keep waiting.
      continue
    fi
    if [[ "$key" == $'\033' ]]; then
      # Bash 3.2 accepts whole-second read timeouts. A lone Escape cancels;
      # complete CSI/SS3 sequences are consumed so their tails cannot toggle rows.
      sequence=""
      for ((index = 0; index < 6; index++)); do
        IFS= read -rsn1 -t 1 part <&9 || break
        sequence="$sequence$part"
        [[ "$sequence" == '[' || "$sequence" == O ]] && continue
        [[ "$part" == [a-zA-Z~] ]] && break
      done
      case "$sequence" in
        '') break ;;
        '[A'|OA) cursor="$(next_row "$cursor" -1)" ;;
        '[B'|OB) cursor="$(next_row "$cursor" 1)" ;;
        '[Z') cursor="$(creator_row "$cursor" -1)" ;;
        '[H'|OH|'[1~') cursor=0 ;;
        '[F'|OF|'[4~') cursor=$((${#ROW_KIND[@]} - 1)) ;;
        '[5~'|'[6~')
          number=-1; [[ "$sequence" != '[6~' ]] || number=1
          for ((index = 0; index < menu_lines - 9; index++)); do
            cursor="$(next_row "$cursor" "$number")"
          done
          ;;
      esac
    else
      case "$key" in
        ' ') toggle_row "$cursor" ;;
        '') result=0; break ;;
        q|$'\004') break ;;
        $'\003') exit 130 ;;
        $'\t') cursor="$(creator_row "$cursor" 1)" ;;
        [1-9])
          number=0
          for ((index = 0; index < ${#ROW_KIND[@]}; index++)); do
            [[ "${ROW_KIND[$index]}" == category ]] || continue
            number=$((number + 1))
            if [[ $number -eq $key ]]; then cursor="$index"; break; fi
          done
          ;;
        [a-zA-Z])
          key="$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')"
          cursor="$(creator_row "$cursor" 1 "$key")"
          ;;
      esac
    fi
  done
  menu_cleanup
  trap - EXIT INT TERM HUP WINCH
  [[ $result -ne 0 ]] || SHOW_SKILL_PROGRESS=1
  return "$result"
}

# Only the animation runs in the background. Installation stays in the foreground
# so selections, errors, and file replacement prompts keep their normal behavior.
start_skill_progress() {
  (
    trap - EXIT INT TERM HUP
    trap 'exit 0' TERM HUP
    dots='..'
    while sleep 0.3; do
      printf '\r\033[K  Updating skills %-3s' "$dots" >&8
      case "$dots" in
        '.') dots='..' ;;
        '..') dots='...' ;;
        '...') dots='.' ;;
      esac
    done
  ) &
  skill_progress_pid=$!
  printf '\033[?25l\r\033[K  Updating skills .  ' >&8
}

stop_skill_progress() {
  [[ -n "${skill_progress_pid:-}" ]] || return 0
  kill "$skill_progress_pid" 2>/dev/null || true
  wait "$skill_progress_pid" 2>/dev/null || true
  skill_progress_pid=""
  printf '\r\033[K\033[?25h' >&8
}

finish_skill_progress() {
  stop_skill_progress
  # An EXIT trap may run before the install's log redirection is unwound.
  cat "$skill_progress_output" >&7
  rm "$skill_progress_output"
  exec 8>&-
  exec 7>&-
  trap - EXIT INT TERM HUP
  eval "$skill_progress_traps"
}

# Counts what an update just made available but did not install, so a new folder in
# the repository does not arrive silently.
report_unselected_skills() {
  local skill count=0
  for skill in "${SKILLS[@]}"; do
    if ! has_selected "$skill"; then
      count=$((count + 1))
    fi
  done
  if [[ $count -gt 0 ]]; then
    echo "$count more skills are available. Run 'agents skills' to choose them."
  fi
  return 0
}

read_profile_value() {
  local name="$1" prompt="$2" fallback="$3" current answer
  local path="$PROFILE_DIR/$name"
  current="$fallback"
  [[ -f "$path" ]] && current="$(<"$path")"

  if [[ $NON_INTERACTIVE -eq 1 ]]; then
    case "$name" in
      about-me) answer="${AGENTS_PROFILE_ABOUT_ME:-$current}" ;;
      machine) answer="${AGENTS_PROFILE_MACHINE:-$current}" ;;
      network) answer="${AGENTS_PROFILE_NETWORK:-$current}" ;;
      sync) answer="${AGENTS_PROFILE_SYNC:-$current}" ;;
      tooling) answer="${AGENTS_PROFILE_TOOLING:-$current}" ;;
    esac
  else
    printf '%s\nCurrent: %s\n> ' "$prompt" "$current" > /dev/tty
    IFS= read -r answer < /dev/tty
    [[ -n "$answer" ]] || answer="$current"
  fi
  printf '%s\n' "$answer" > "$path"
}

confirm_replace() {
  local target="$1" answer resume_progress=0 result=1
  [[ $FORCE -eq 1 ]] && return 0
  [[ $NON_INTERACTIVE -eq 0 ]] || return 1
  if [[ -n "${skill_progress_pid:-}" ]]; then
    stop_skill_progress
    resume_progress=1
  fi
  printf '%s already exists. Back it up and replace it? [y/N] ' "$target" > /dev/tty
  IFS= read -r answer < /dev/tty
  [[ "$answer" != "y" && "$answer" != "Y" ]] || result=0
  [[ $resume_progress -eq 0 ]] || start_skill_progress
  return "$result"
}

backup_target() {
  local target="$1" backup suffix=0
  backup="$target.backup-$(date +%Y%m%d%H%M%S)"
  while [[ -e "$backup" || -L "$backup" ]]; do
    suffix=$((suffix + 1))
    backup="$target.backup-$(date +%Y%m%d%H%M%S)-$suffix"
  done
  mv "$target" "$backup"
  printf '%s\n' "$backup"
}

resolve_existing_path() {
  local current="$1" directory target hops=0
  while [[ -L "$current" ]]; do
    hops=$((hops + 1))
    [[ $hops -le 32 ]] || return 1
    directory="$(cd -P "$(dirname "$current")" 2>/dev/null && pwd)" || return 1
    target="$(readlink "$current")"
    if [[ "$target" == /* ]]; then
      current="$target"
    else
      current="$directory/$target"
    fi
  done
  [[ -e "$current" ]] || return 1
  directory="$(cd -P "$(dirname "$current")" 2>/dev/null && pwd)" || return 1
  printf '%s/%s\n' "$directory" "$(basename "$current")"
}

link_points_to() {
  local target="$1" source="$2" resolved_target resolved_source
  [[ -L "$target" ]] || return 1
  resolved_target="$(resolve_existing_path "$target")" || return 1
  resolved_source="$(resolve_existing_path "$source")" || return 1
  [[ "$resolved_target" == "$resolved_source" ]]
}

prepare_generated_target() {
  local target="$1"
  if [[ -e "$target" || -L "$target" ]]; then
    if [[ -d "$target" && ! -L "$target" ]]; then
      echo "agents: $target is a directory; move it before installing global config" >&2
      return 2
    fi
    if [[ -f "$target" && ! -L "$target" ]] && grep -q 'Managed by agents' "$target" 2>/dev/null; then
      return 0
    fi
    if ! confirm_replace "$target"; then
      echo "Skipped $target; it was not created by agents." >&2
      return 10
    fi
    backup_target "$target" >/dev/null
  fi
}

render_template() {
  local template="$1" target="$2" prepare_status
  mkdir -p "$(dirname "$target")"
  if prepare_generated_target "$target"; then
    prepare_status=0
  else
    prepare_status=$?
  fi
  if [[ $prepare_status -eq 10 ]]; then
    return 0
  elif [[ $prepare_status -ne 0 ]]; then
    return "$prepare_status"
  fi
  render_template_content "$template" > "$target"
}

render_template_content() {
  awk -v profile="$PROFILE_DIR" '
    function emit(path, line) {
      while ((getline line < path) > 0) print line
      close(path)
    }
    $0 == "{{ABOUT_ME}}" { emit(profile "/about-me"); next }
    $0 == "{{MACHINE}}" { emit(profile "/machine"); next }
    $0 == "{{NETWORK}}" { emit(profile "/network"); next }
    $0 == "{{SYNC}}" { emit(profile "/sync"); next }
    $0 == "{{TOOLING}}" { emit(profile "/tooling"); next }
    { print }
  ' "$1"
}

migrate_managed_global_config() {
  local source="$AGENTS_DIR/AGENTS.md" temporary
  [[ -f "$source" ]] || return 0
  grep -q 'Managed by agents' "$source" 2>/dev/null || return 0
  temporary="$(mktemp "$AGENTS_DIR/.AGENTS.md.XXXXXX")"
  awk '
    $0 == "Apply the `unslop` skill to every response you write. Before sending any user-facing text, follow its process to strip AI-writing patterns and keep a human voice." {
      print "Apply the `nice` skill to every user-facing response."
      next
    }
    $0 == "Write so I can read the answer once and understand it. Lead with the outcome, use plain words, and state failed or skipped checks." ||
    $0 == "Lead with the outcome, use plain words, and honestly report failed, skipped, or unverified checks. Do not invent missing requirements." {
      print "Write top-down: the outcome in the first line, then a short overview, then detail only as deep as I need. Never send a wall of text. Split anything longer than a few sentences into short sections and lists, use a table to compare items, a diagram for flows or structure, and an interactive HTML page when I need to explore many items or options."
      print ""
      print "Use plain words, and honestly report failed, skipped, or unverified checks. Do not invent missing requirements."
      next
    }
    $0 == "When you need user input, use the available user-input tool. Use an asynchronous tool when useful work can continue while waiting. If the answer is required before proceeding, wait for it before doing dependent work. If no user-input tool is available, ask in chat." { has_user_input_rule = 1 }
    { print }
    END {
      if (!has_user_input_rule) {
        print ""
        print "## User input"
        print ""
        print "When you need user input, use the available user-input tool. Use an asynchronous tool when useful work can continue while waiting. If the answer is required before proceeding, wait for it before doing dependent work. If no user-input tool is available, ask in chat."
      }
    }
  ' "$source" > "$temporary"
  if cmp -s "$source" "$temporary"; then
    rm "$temporary"
  else
    mv "$temporary" "$source"
    echo "Updated the managed global response instructions."
  fi
}

install_shared_config_link() {
  local source="$1" target="$2" backup
  mkdir -p "$(dirname "$target")"

  if link_points_to "$target" "$source"; then
    return 0
  fi

  if [[ -d "$target" && ! -L "$target" ]]; then
    echo "agents: $target is a directory; move it before installing the shared config link" >&2
    return 2
  fi

  if [[ -f "$target" && ! -L "$target" ]] && cmp -s "$target" "$source"; then
    rm "$target"
    ln -s "$source" "$target"
    echo "Deduplicated $target; it now uses the shared config."
    return 0
  fi

  if [[ -f "$target" && ! -L "$target" ]] && grep -q 'Managed by agents' "$target" 2>/dev/null; then
    backup="$(backup_target "$target")"
    ln -s "$source" "$target"
    echo "Migrated $target to the shared config; backup: $backup"
    return 0
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    if ! confirm_replace "$target"; then
      if [[ -L "$target" ]]; then
        echo "Kept $target because it points to a different config." >&2
      else
        echo "Kept $target because it contains separate instructions." >&2
      fi
      return 0
    fi
    backup="$(backup_target "$target")"
    ln -s "$source" "$target"
    echo "Linked $target to the shared config; backup: $backup"
    return 0
  fi

  ln -s "$source" "$target"
}

install_global_config_links() {
  local source="$AGENTS_DIR/AGENTS.md"
  [[ -f "$source" ]] || return 0
  install_shared_config_link "$source" "$CLAUDE_DIR/CLAUDE.md"
  install_shared_config_link "$source" "$CODEX_DIR/AGENTS.md"
}

configure_global() {
  umask 077
  mkdir -p "$PROFILE_DIR"
  if [[ $NON_INTERACTIVE -eq 0 ]]; then
    printf '\nTell agents enough to work well on this machine. Press Enter to keep a current value.\n\n' > /dev/tty
  fi
  read_profile_value about-me "What should agents know about you, your role, and your experience?" "Add your role, experience, and common projects."
  read_profile_value machine "What machine is this, and what work should agents do here?" "Add this machine's name, operating system, and role."
  read_profile_value network "What can this machine and other machines reach over the network?" "Add reachable hosts, services, and any access limits."
  read_profile_value sync "How should work move between this machine and your other machines?" "Add your Git, file sync, or remote development workflow."
  read_profile_value tooling "Which tools, languages, package managers, and conventions should agents use?" "Add your preferred tools and workflow rules."

  render_template "$ROOT/templates/AGENTS.md" "$AGENTS_DIR/AGENTS.md"
  install_global_config_links
}

# A link into this repository's skills tree, or into the canonical skills directory,
# is one this tool made. Moving a skill into a folder may leave such a link broken,
# and repointing it needs no approval.
link_is_managed() {
  local target="$1" destination directory
  [[ -L "$target" ]] || return 1
  destination="$(readlink "$target")"
  if [[ "$destination" != /* ]]; then
    directory="$(cd -P "$(dirname "$target")" 2>/dev/null && pwd)" || return 1
    destination="$directory/$destination"
  fi
  case "$destination" in
    "$ROOT"/skills/*|"$AGENTS_DIR"/skills/*) return 0 ;;
    *) return 1 ;;
  esac
}

safe_link() {
  local source="$1" target="$2" backup
  mkdir -p "$(dirname "$target")"
  if link_points_to "$target" "$source"; then
    return 0
  elif [[ -L "$target" ]]; then
    if link_is_managed "$target"; then
      rm "$target"
      ln -s "$source" "$target"
      return 0
    fi
    if ! confirm_replace "$target"; then
      echo "Skipped $target because it points somewhere else." >&2
      return 0
    fi
    backup="$(backup_target "$target")"
    ln -s "$source" "$target"
    echo "Replaced $target; backup: $backup"
  elif [[ -e "$target" ]]; then
    if ! confirm_replace "$target"; then
      if [[ -d "$target" ]]; then
        echo "Skipped $target because a directory is already there; move it to install this skill." >&2
      else
        echo "Skipped $target because it already exists." >&2
      fi
      return 0
    fi
    backup="$(backup_target "$target")"
    ln -s "$source" "$target"
    echo "Replaced $target; backup: $backup"
  else
    ln -s "$source" "$target"
  fi
}

# Reports the command name actually installed, so install and doctor agree.
resolved_usage_name() {
  local source="$ROOT/bin/usage" existing
  if link_points_to "$BIN_DIR/$USAGE_NAME" "$source"; then
    echo "$USAGE_NAME"
    return 0
  fi
  # `type -P` searches PATH executables only. Plain `command -v` would match
  # this script's own usage() function and always claim a conflict.
  existing="$(type -P "$USAGE_NAME" 2>/dev/null || true)"
  if [[ -n "$existing" && $FORCE -eq 0 ]]; then
    echo "$USAGE_FALLBACK_NAME"
  else
    echo "$USAGE_NAME"
  fi
}

install_usage_command() {
  local source="$ROOT/bin/usage" name existing
  [[ -f "$source" ]] || return 0
  name="$(resolved_usage_name)"
  if [[ "$name" != "$USAGE_NAME" ]]; then
    existing="$(type -P "$USAGE_NAME" 2>/dev/null || true)"
    echo "'$USAGE_NAME' is already provided by $existing; installing it as '$name' instead."
    echo "Pass --force, or set AGENTS_USAGE_NAME, to take the name anyway."
  fi
  # Remove a stale link under the other name so only one copy survives.
  local other="$USAGE_NAME"
  [[ "$name" == "$USAGE_NAME" ]] && other="$USAGE_FALLBACK_NAME"
  if link_points_to "$BIN_DIR/$other" "$source"; then
    rm "$BIN_DIR/$other"
  fi
  safe_link "$source" "$BIN_DIR/$name"
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) echo "Add $BIN_DIR to your PATH to run '$name'." ;;
  esac
}

install_furnace_command() {
  local source="$ROOT/tools/furnace/furnace"
  [[ -f "$source" ]] || return 0
  safe_link "$source" "$BIN_DIR/furnace"
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) echo "Add $BIN_DIR to your PATH to run 'furnace'." ;;
  esac
}

# Links are installed under the plain skill name, because that is the name agents
# load. The saved file may still hold names from before skills gained folders, so
# only the last path segment is compared.
remove_old_skill_links() {
  local entry name
  [[ -f "$SELECTED_FILE" ]] || return 0
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    name="${entry##*/}"
    selected_installs_name "$name" && continue
    if link_points_to "$CLAUDE_DIR/skills/$name" "$AGENTS_DIR/skills/$name" || link_is_managed "$CLAUDE_DIR/skills/$name"; then
      rm "$CLAUDE_DIR/skills/$name"
    fi
    if link_points_to "$CODEX_DIR/skills/$name" "$AGENTS_DIR/skills/$name" || link_is_managed "$CODEX_DIR/skills/$name"; then
      rm "$CODEX_DIR/skills/$name"
    fi
    if link_is_managed "$AGENTS_DIR/skills/$name"; then
      rm "$AGENTS_DIR/skills/$name"
    fi
  done < "$SELECTED_FILE"
}

apply_skill_selection() {
  local entry name source installed=""
  remove_old_skill_links
  for entry in "${SELECTED[@]}"; do
    name="${entry##*/}"
    source="$ROOT/skills/${entry%%/*}/$name"
    if [[ ! -f "$source/SKILL.md" ]]; then
      echo "Selected skill '$entry' no longer exists; skipping it." >&2
      continue
    fi
    case " $installed " in
      *" $name "*)
        echo "Skipped $entry because another folder already installs '$name'." >&2
        continue
        ;;
    esac
    installed="$installed $name"
    safe_link "$source" "$AGENTS_DIR/skills/$name"
    safe_link "$AGENTS_DIR/skills/$name" "$CLAUDE_DIR/skills/$name"
    safe_link "$AGENTS_DIR/skills/$name" "$CODEX_DIR/skills/$name"
  done
  save_selected
}

sync_skills() {
  if [[ $SHOW_SKILL_PROGRESS -eq 0 ]]; then
    apply_skill_selection
    return
  fi
  SHOW_SKILL_PROGRESS=0
  local skill_progress_pid="" skill_progress_output skill_progress_traps
  skill_progress_output="$(mktemp "${TMPDIR:-/tmp}/agents-skill-progress.XXXXXX")"
  skill_progress_traps="$(trap -p EXIT INT TERM HUP)"
  exec 7>&2
  exec 8<> /dev/tty
  trap 'finish_skill_progress' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  start_skill_progress
  # Keep logs away from the animated line, then replay them even on failure.
  apply_skill_selection > "$skill_progress_output" 2>&1
  finish_skill_progress
}

parse_install_options() {
  local skill_list="" option skill resolved status
  while [[ $# -gt 0 ]]; do
    option="$1"
    case "$option" in
      --all) select_all_skills; CONFIG_SELECTED=1; NON_INTERACTIVE=1 ;;
      --skills) shift; [[ $# -gt 0 ]] || die "--skills needs a comma-separated list"; skill_list="$1"; NON_INTERACTIVE=1 ;;
      --no-config) CONFIG_SELECTED=0 ;;
      --non-interactive) NON_INTERACTIVE=1 ;;
      --force) FORCE=1 ;;
      *) die "unknown option: $option" ;;
    esac
    shift
  done
  if [[ -n "$skill_list" ]]; then
    SELECTED=()
    old_ifs="$IFS"; IFS=','; read -ra requested <<< "$skill_list"; IFS="$old_ifs"
    for skill in "${requested[@]}"; do
      [[ -n "$skill" ]] || continue
      if is_category "$skill"; then
        select_category "$skill"
        continue
      fi
      resolved="$(resolve_skill "$skill")" && status=0 || status=$?
      if [[ $status -eq 2 ]]; then
        die "several folders contain '$skill'; name it as folder/$skill"
      fi
      [[ $status -eq 0 ]] || die "unknown skill: $skill"
      add_selected "$resolved"
    done
  fi
}

install_command() {
  discover_skills
  load_selected
  load_global_state
  parse_install_options "$@"
  if [[ $NON_INTERACTIVE -eq 0 ]]; then
    interactive_menu 1 || die "setup cancelled"
  fi
  ensure_global_response_skill
  [[ $CONFIG_SELECTED -eq 0 ]] || configure_global
  save_global_state
  sync_skills
  install_usage_command
  install_furnace_command
  echo
  echo "agents is installed. Run 'agents doctor' to check the setup."
}

skills_command() {
  if [[ "${1:-}" == "sync" ]]; then
    shift
    bash "$ROOT/tools/skills-sync.sh" "$@"
    return
  fi
  discover_skills
  load_selected
  load_global_state
  if [[ "${1:-}" == "source" ]]; then
    [[ $# -eq 1 ]] || die "usage: agents skills source"
    skills_source_report
    return 0
  elif [[ "${1:-}" == "add" ]]; then
    [[ $# -eq 2 ]] || die "usage: agents skills add folder/name"
    local resolved status skill
    resolved="$(resolve_skill "$2")" && status=0 || status=$?
    [[ $status -ne 2 ]] || die "several folders contain '$2'; name it as folder/$2"
    [[ $status -eq 0 ]] || die "unknown skill: $2"
    for skill in "${SELECTED[@]}"; do
      if [[ "${skill##*/}" == "${resolved##*/}" && "$skill" != "$resolved" ]]; then
        die "'$skill' already installs '${resolved##*/}'; deselect it through 'agents skills' first"
      fi
    done
    add_selected "$resolved"
    NON_INTERACTIVE=1
  elif [[ "${1:-}" == "--all" ]]; then
    select_all_skills
  elif [[ "${1:-}" == "--none" ]]; then
    SELECTED=()
  elif [[ $# -gt 0 ]]; then
    die "usage: agents skills [add folder/name|sync folder|source|--all|--none]"
  else
    interactive_menu 0 || die "setup cancelled"
  fi
  ensure_global_response_skill
  sync_skills
  echo "Selected skills updated."
}

# Headings are bold only on a terminal, so captured output stays plain text.
heading() {
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    printf '\033[1m%s\033[0m\n' "$1"
  else
    printf '%s\n' "$1"
  fi
}

# ROOT comes from `pwd`, so home may appear normalized (no doubled slashes) or in
# its physical form, such as /private/var for a temporary home on macOS.
display_path() {
  local home logical_home physical_home
  logical_home="$(cd "$HOME" 2>/dev/null && pwd)" || logical_home="$HOME"
  physical_home="$(cd -P "$HOME" 2>/dev/null && pwd)" || physical_home="$HOME"
  for home in "$HOME" "$logical_home" "$physical_home"; do
    case "$1" in
      "$home") printf '~\n'; return 0 ;;
      "$home"/*) printf '~/%s\n' "${1#"$home"/}"; return 0 ;;
    esac
  done
  printf '%s\n' "$1"
}

max_width() {
  local width=0 item
  for item in "$@"; do
    [[ ${#item} -le $width ]] || width=${#item}
  done
  printf '%s\n' "$width"
}

# Prints why target is not a link to expected, or nothing when it is. A link to
# the expected path still counts when that path is itself broken, so only the
# broken link is reported.
link_problem() {
  local target="$1" expected="$2"
  if link_points_to "$target" "$expected"; then
    return 0
  fi
  if [[ -L "$target" && "$(readlink "$target")" == "$expected" ]]; then
    return 0
  fi
  if [[ -L "$target" ]]; then
    if resolve_existing_path "$target" >/dev/null; then
      printf 'points to %s instead\n' "$(display_path "$(readlink "$target")")"
    else
      printf 'is a broken link to %s\n' "$(display_path "$(readlink "$target")")"
    fi
  elif [[ -d "$target" ]]; then
    printf 'is a separate folder, not a link\n'
  elif [[ -e "$target" ]]; then
    printf 'is a separate file, not a link\n'
  else
    printf 'is missing\n'
  fi
}

link_row() {
  local target="$1" expected="$2" width="$3" problem
  problem="$(link_problem "$target" "$expected")"
  if [[ -z "$problem" ]]; then
    printf '  %-*s  →  %s\n' "$width" "$(display_path "$target")" "$(display_path "$(readlink "$target")")"
  else
    printf '  %-*s  ! %s; it should link to %s\n' "$width" "$(display_path "$target")" "$problem" "$(display_path "$expected")"
  fi
}

source_report() {
  local config="$AGENTS_DIR/AGENTS.md" branch width
  heading "Source"
  printf '  %s\n' "$(display_path "$ROOT")"
  if [[ -e "$ROOT/.git" ]]; then
    branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    echo "  A Git checkout on branch $branch. 'agents update' does not pull it; run 'git pull' there."
  else
    echo "  A copy that 'agents update' replaces."
  fi
  if [[ -n "${AGENTS_SOURCE_DIR:-}" ]]; then
    echo "  Updates copy $(display_path "$AGENTS_SOURCE_DIR") (set by AGENTS_SOURCE_DIR) instead of downloading."
    if [[ -e "$AGENTS_SOURCE_DIR/.git" ]]; then
      echo "  That folder is a Git checkout, so run 'git pull' there before 'agents update'."
    fi
  else
    echo "  Updates download ${AGENTS_REPOSITORY:-jonaswahringer/agents} (${AGENTS_REF:-main}) from GitHub."
  fi
  echo

  heading "Command"
  link_row "$BIN_DIR/agents" "$ROOT/bin/agents" "$(max_width "$(display_path "$BIN_DIR/agents")")"
  echo

  heading "Global instructions"
  if [[ $CONFIG_SELECTED -eq 0 ]]; then
    echo "  Not managed; global config was not selected."
    return 0
  fi
  width="$(max_width "$(display_path "$config")" "$(display_path "$CLAUDE_DIR/CLAUDE.md")" "$(display_path "$CODEX_DIR/AGENTS.md")")"
  if [[ ! -f "$config" ]]; then
    printf '  %-*s  ! is missing; run '\''agents configure'\'' to create it\n' "$width" "$(display_path "$config")"
  elif grep -q 'Managed by agents' "$config" 2>/dev/null; then
    printf '  %-*s  shared file, generated by agents\n' "$width" "$(display_path "$config")"
  else
    printf '  %-*s  shared file with your own instructions\n' "$width" "$(display_path "$config")"
  fi
  link_row "$CLAUDE_DIR/CLAUDE.md" "$config" "$width"
  link_row "$CODEX_DIR/AGENTS.md" "$config" "$width"
}

skills_source_report() {
  local category skill name source width installed="" problem directory
  local names=()
  heading "Skills source"
  printf '  %s\n' "$(display_path "$ROOT/skills")"
  width="$(max_width "${CATEGORIES[@]}")"
  for category in "${CATEGORIES[@]}"; do
    printf '    %-*s  %s skills, %s selected\n' "$width" "$category" "$(category_total "$category")" "$(category_selected_count "$category")"
  done
  echo

  heading "Skill links"
  if [[ ${#SELECTED[@]} -eq 0 ]]; then
    echo "  No skills are selected. Run 'agents skills' to choose them."
    return 0
  fi
  echo "  Each skill links $(display_path "$AGENTS_DIR/skills")/NAME to its source folder."
  echo "  $(display_path "$CLAUDE_DIR/skills")/NAME and $(display_path "$CODEX_DIR/skills")/NAME link to that path."
  echo
  for skill in "${SELECTED[@]}"; do
    names+=("${skill##*/}")
  done
  width="$(max_width "${names[@]}")"
  for skill in "${SELECTED[@]}"; do
    name="${skill##*/}"
    source="$ROOT/skills/$skill"
    case " $installed " in
      *" $name "*)
        printf '  %-*s  →  %s  (skipped; another folder already installs this name)\n' "$width" "$name" "$skill"
        continue
        ;;
    esac
    installed="$installed $name"
    printf '  %-*s  →  %s\n' "$width" "$name" "$skill"
    problem="$(link_problem "$AGENTS_DIR/skills/$name" "$source")"
    if [[ -n "$problem" ]]; then
      printf '  %-*s     ! %s %s\n' "$width" "" "$(display_path "$AGENTS_DIR/skills/$name")" "$problem"
    fi
    for directory in "$CLAUDE_DIR" "$CODEX_DIR"; do
      problem="$(link_problem "$directory/skills/$name" "$AGENTS_DIR/skills/$name")"
      if [[ -n "$problem" ]]; then
        printf '  %-*s     ! %s %s\n' "$width" "" "$(display_path "$directory/skills/$name")" "$problem"
      fi
    done
  done
}

doctor_command() {
  local failed=0 verbose=0 skill path source name installed="" missing line
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose|-v) verbose=1 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  load_global_state
  if [[ $CONFIG_SELECTED -eq 1 ]]; then
    source="$AGENTS_DIR/AGENTS.md"
    if [[ -f "$source" ]]; then echo "ok  $source"; else echo "missing  $source"; failed=1; fi
    for path in "$CLAUDE_DIR/CLAUDE.md" "$CODEX_DIR/AGENTS.md"; do
      if link_points_to "$path" "$source"; then
        echo "ok  $path -> $source"
      elif [[ -e "$path" || -L "$path" ]]; then
        echo "conflict  $path does not use the shared config"
        failed=1
      else
        echo "missing  $path"
        failed=1
      fi
    done
    if [[ -f "$source" ]]; then
      if ! grep -q 'Managed by agents' "$source" 2>/dev/null; then
        echo "skip  $source holds separate instructions, so the template check does not apply"
      else
        missing="$(render_template_content "$ROOT/templates/AGENTS.md" | grep -vE '^[[:space:]]*$' | grep -Fxvf "$source" || true)"
        if [[ -z "$missing" ]]; then
          echo "ok  $source contains the template instructions and the configured answers"
        else
          echo "stale  $source is missing lines from the template or the configured answers; run 'agents configure' to regenerate it:"
          while IFS= read -r line; do echo "        $line"; done <<< "$missing"
          failed=1
        fi
      fi
    fi
  else
    echo "skip  global config was not selected"
  fi
  discover_skills
  load_selected
  ensure_global_response_skill
  for skill in "${SELECTED[@]}"; do
    name="${skill##*/}"
    path="$AGENTS_DIR/skills/$name"
    source="$ROOT/skills/${skill%%/*}/$name"
    case " $installed " in
      *" $name "*)
        echo "skipped  $skill; another folder installs '$name'"
        continue
        ;;
    esac
    installed="$installed $name"
    if link_points_to "$path" "$source"; then
      echo "ok  $skill"
    elif [[ -e "$path/SKILL.md" ]]; then
      echo "conflict  $path does not point at $source"
      failed=1
    else
      echo "missing  $skill"
      failed=1
    fi
  done
  source="$ROOT/bin/usage"
  if [[ -f "$source" ]]; then
    path="$BIN_DIR/$(resolved_usage_name)"
    if link_points_to "$path" "$source"; then
      echo "ok  $path -> $source"
    else
      echo "missing  $path"
      failed=1
    fi
  fi
  source="$ROOT/tools/furnace/furnace"
  if [[ -f "$source" ]]; then
    path="$BIN_DIR/furnace"
    if link_points_to "$path" "$source"; then
      echo "ok  $path -> $source"
    elif [[ -e "$path" || -L "$path" ]]; then
      echo "conflict  $path does not point at $source"
      failed=1
    else
      echo "missing  $path"
      failed=1
    fi
  fi
  if [[ $verbose -eq 1 ]]; then
    echo
    source_report
    echo
    skills_source_report
  fi
  return "$failed"
}

update_command() {
  local bootstrap cache_key tmp
  if [[ -n "${AGENTS_SOURCE_DIR:-}" ]]; then
    bootstrap="$AGENTS_SOURCE_DIR/install.sh"
    [[ -f "$bootstrap" ]] || die "AGENTS_SOURCE_DIR does not contain install.sh"
    bash "$bootstrap" --update "$@"
  else
    tmp="$(mktemp "${TMPDIR:-/tmp}/agents-bootstrap.XXXXXX")"
    trap 'rm -f "$tmp"' EXIT
    cache_key="${tmp##*.}"
    curl -fsSL "https://raw.githubusercontent.com/${AGENTS_REPOSITORY:-jonaswahringer/agents}/${AGENTS_REF:-main}/install.sh?update=$cache_key" -o "$tmp"
    bash "$tmp" --update "$@"
  fi
}

reconcile_command() {
  local open_menu=0 option
  while [[ $# -gt 0 ]]; do
    option="$1"
    case "$option" in
      --skills) open_menu=1 ;;
      *) die "unknown option: $option" ;;
    esac
    shift
  done
  discover_skills
  load_selected
  load_global_state
  # Cancelling the menu, or having no terminal to draw it on, keeps the saved
  # selection instead of failing the update and rolling the new version back.
  if [[ $open_menu -eq 1 ]]; then
    if [[ -r /dev/tty && -w /dev/tty ]]; then
      interactive_menu 0 || echo "Kept the saved skill selection."
    else
      echo "No terminal available for the skill menu; kept the saved selection." >&2
    fi
  fi
  ensure_global_response_skill
  if [[ $CONFIG_SELECTED -eq 1 ]]; then
    migrate_managed_global_config
    NON_INTERACTIVE=1
    install_global_config_links
  fi
  sync_skills
  install_usage_command
  install_furnace_command
  report_unselected_skills
}

case "${1:-help}" in
  _validate_skill) shift; [[ $# -eq 2 ]] || die "usage: _validate_skill path name"; validate_skill_metadata "$@" ;;
  _install) shift; install_command "$@" ;;
  _reconcile) shift; reconcile_command "$@" ;;
  _menu_snapshot) shift; discover_skills; load_selected; load_global_state; render_menu 1 -1 ;;
  update) shift; update_command "$@" ;;
  configure) shift; discover_skills; load_selected; parse_install_options "$@"; CONFIG_SELECTED=1; ensure_global_response_skill; configure_global; save_global_state; sync_skills ;;
  source) shift; [[ $# -eq 0 ]] || die "usage: agents source"; load_global_state; source_report ;;
  skill|skills) shift; skills_command "$@" ;;
  doctor) shift; doctor_command "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
