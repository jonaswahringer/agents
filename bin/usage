#!/usr/bin/env python3
"""Show how much subscription quota is left across Claude Code, Codex and Cursor.

Polls each vendor's usage endpoint rather than estimating from local logs, so the
numbers match what the vendor thinks -- including usage from other machines.
"""

import argparse
import concurrent.futures as futures
import datetime as dt
import itertools
import json
import os
import select
import shutil
import subprocess
import sqlite3
import sys
import termios
import time
import tty
import urllib.error
import urllib.request

TIMEOUT = 20
STREAM_SECONDS = 90  # how long `usage live` waits between polls


class Unavailable(Exception):
    """Provider can't be read -- not signed in, or the endpoint refused us."""


def get_json(url, headers):
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:200]
        raise Unavailable(f"HTTP {e.code}: {detail}") from e
    except OSError as e:
        raise Unavailable(str(e)) from e
    except ValueError as e:  # an error page where JSON was promised
        raise Unavailable(f"unreadable reply from {url}: {e}") from e


class Window:
    """One quota window: what fraction is used and when it resets."""

    def __init__(self, label, percent, resets_at):
        self.label = label
        self.percent = percent
        self.resets_at = resets_at
        # Set only for spend-denominated windows, where dollars are the real
        # unit and the percentage is derived.
        self.used_dollars = None
        self.limit_dollars = None

    @classmethod
    def spend(cls, label, used_cents, limit_cents, resets_at):
        """A window measured in money rather than in messages."""
        window = cls(label, round(100 * used_cents / limit_cents), resets_at)
        window.used_dollars = used_cents / 100
        window.limit_dollars = limit_cents / 100
        return window

    def as_dict(self):
        return {
            "label": self.label,
            "used_percent": self.percent,
            "remaining_percent": None if self.percent is None else 100 - self.percent,
            "used_dollars": self.used_dollars,
            "limit_dollars": self.limit_dollars,
            "resets_at": None if self.resets_at is None else self.resets_at.isoformat(),
        }


# --- Claude Code ------------------------------------------------------------
# Credentials live in the login keychain; ~/.claude/.credentials.json is a stale
# copy on machines where the keychain is in use, so the keychain wins.

def claude_token():
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
            capture_output=True, text=True, timeout=TIMEOUT,
        )
    except OSError as e:
        raise Unavailable(str(e)) from e
    blobs = []
    if out.returncode == 0 and out.stdout.strip():
        blobs.append(out.stdout)
    path = os.path.expanduser("~/.claude/.credentials.json")
    if os.path.exists(path):
        with open(path) as f:
            blobs.append(f.read())

    best = None
    for blob in blobs:
        try:
            oauth = json.loads(blob)["claudeAiOauth"]
        except (ValueError, KeyError):
            continue
        if best is None or oauth.get("expiresAt", 0) > best.get("expiresAt", 0):
            best = oauth
    if best is None:
        raise Unavailable("not signed in to Claude Code")
    expires = best.get("expiresAt")
    if expires and expires / 1000 < dt.datetime.now().timestamp():
        raise Unavailable("token expired -- run `claude` once to refresh it")
    return best["accessToken"]


def claude_version():
    try:
        out = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=TIMEOUT)
        if out.returncode == 0:
            return out.stdout.split()[0]
    except OSError:
        pass
    return "2.1.212"


def claude_usage():
    # The User-Agent matters: without a claude-code/<version> UA the endpoint
    # answers 429 permanently, with no Retry-After to back off against.
    data = get_json(
        "https://api.anthropic.com/api/oauth/usage",
        {
            "Authorization": "Bearer " + claude_token(),
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": f"claude-code/{claude_version()}",
        },
    )
    windows = []
    for limit in data.get("limits") or []:
        scope = (limit.get("scope") or {}).get("model") or {}
        name = scope.get("display_name")
        label = {
            "session": "5-hour session",
            "weekly_all": "Weekly (all models)",
            "weekly_scoped": f"Weekly ({name or 'scoped'})",
        }.get(limit.get("kind"), limit.get("kind", "unknown"))
        windows.append(Window(label, limit.get("percent"), parse_time(limit.get("resets_at"))))

    if not windows:  # older response shape, before `limits` was added
        for key, label in (("five_hour", "5-hour session"), ("seven_day", "Weekly (all models)")):
            w = data.get(key)
            if w:
                windows.append(Window(label, w.get("utilization"), parse_time(w.get("resets_at"))))
    return {"plan": None, "windows": windows}


# --- Codex ------------------------------------------------------------------

def codex_usage():
    path = os.path.expanduser("~/.codex/auth.json")
    if not os.path.exists(path):
        raise Unavailable("not signed in to Codex")
    with open(path) as f:
        tokens = json.load(f).get("tokens") or {}
    if not tokens.get("access_token"):
        raise Unavailable("no Codex OAuth token (API-key mode has no quota window)")

    data = get_json(
        "https://chatgpt.com/backend-api/wham/usage",
        {
            "Authorization": "Bearer " + tokens["access_token"],
            "chatgpt-account-id": tokens.get("account_id", ""),
            "User-Agent": "codex_cli_rs",
        },
    )
    rate = data.get("rate_limit") or {}
    windows = []
    for key, label in (("primary_window", "Primary"), ("secondary_window", "Secondary")):
        w = rate.get(key)
        if not w:
            continue
        secs = w.get("limit_window_seconds")
        windows.append(Window(
            describe_window(secs) if secs else label,
            w.get("used_percent"),
            reset_from_epoch(w.get("reset_at")) or reset_from_offset(w.get("reset_after_seconds")),
        ))
    return {"plan": data.get("plan_type"), "windows": windows}


# --- Cursor -----------------------------------------------------------------
# Two credential sources: the cursor-agent CLI keeps its token in the login
# keychain, the desktop editor keeps one in state.vscdb. Either works, so the
# CLI alone is enough -- the editor need not be installed.

CURSOR_DBS = [
    "~/Library/Application Support/Cursor/User/globalStorage/state.vscdb",
    "~/.config/Cursor/User/globalStorage/state.vscdb",
]


def cursor_credentials():
    token = subprocess.run(
        ["security", "find-generic-password", "-s", "cursor-access-token",
         "-a", "cursor-user", "-w"],
        capture_output=True, text=True, timeout=TIMEOUT,
    ).stdout.strip()
    user_id = None
    config = os.path.expanduser("~/.cursor/cli-config.json")
    if os.path.exists(config):
        with open(config) as f:
            user_id = (json.load(f).get("authInfo") or {}).get("userId")
    if token and user_id:
        return f"user_{user_id}%3A%3A{token}"

    db = next((p for p in (os.path.expanduser(p) for p in CURSOR_DBS) if os.path.exists(p)), None)
    if db:
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        try:
            row = conn.execute(
                "select value from ItemTable where key = 'cursorAuth/accessToken'"
            ).fetchone()
        finally:
            conn.close()
        if row and row[0]:
            return row[0]
    raise Unavailable("not signed in -- run `cursor-agent login` or sign in to Cursor")


def cursor_usage():
    cookie = cursor_credentials()
    headers = {"Cookie": f"WorkosCursorSessionToken={cookie}", "User-Agent": "aiusage"}

    # Everything quota-related lives on one endpoint: the cycle dates, both
    # included pools and the on-demand cap.
    data = get_json("https://cursor.com/api/usage-summary", headers)
    resets_at = parse_time(data.get("billingCycleEnd"))
    usage = data.get("individualUsage") or data.get("teamUsage") or {}

    # Pro includes two separate pools, and only these percentages compare them
    # honestly -- see the note on `used`/`limit` in docs/usage.md.
    windows = []
    plan_quota = usage.get("plan") or {}
    for key, label in (("autoPercentUsed", "Cursor models"),
                       ("apiPercentUsed", "Other models")):
        if plan_quota.get(key) is not None:
            windows.append(Window(label, plan_quota[key], resets_at))
    # The on-demand cap only buys usage *past* those pools, so it is noise until
    # something has actually been charged against it. Here dollars are the unit
    # the vendor itself uses, and both halves come from the same pot.
    extra = usage.get("onDemand") or {}
    if extra.get("used") and extra.get("limit"):
        windows.append(Window.spend(
            "On-demand spend", extra["used"], extra["limit"], resets_at))
    return {"plan": data.get("membershipType"), "status": cursor_status(headers),
            "windows": windows}


def cursor_status(headers):
    """Billing trouble worth flagging, or None while the subscription is fine.

    A nice-to-have, so failing to read it must not cost us the quota.
    """
    try:
        status = get_json("https://cursor.com/api/auth/stripe", headers).get("subscriptionStatus")
    except Unavailable:
        return None
    return None if status in (None, "active", "trialing") else status


# --- formatting -------------------------------------------------------------

SPINNER = "|/-\\"


def parse_time(value):
    if not value:
        return None
    try:
        # fromisoformat rejects a trailing Z before Python 3.11.
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone()
    except (ValueError, AttributeError):
        return None


def reset_from_epoch(value):
    return None if not value else dt.datetime.fromtimestamp(value).astimezone()


def reset_from_offset(seconds):
    if seconds is None:
        return None
    return (dt.datetime.now() + dt.timedelta(seconds=seconds)).astimezone()


def describe_window(seconds):
    for size, name in ((604800, "Weekly"), (86400, "Daily"), (18000, "5-hour"), (3600, "Hourly")):
        if seconds == size:
            return name
    return f"{seconds // 3600}-hour"


def humanize_until(when):
    if when is None:
        return "unknown"
    delta = when - dt.datetime.now().astimezone()
    secs = int(delta.total_seconds())
    if secs <= 0:
        return "now"
    days, rem = divmod(secs, 86400)
    hours, mins = divmod(rem // 60, 60)
    parts = [f"{days}d" if days else "", f"{hours}h" if hours else "", f"{mins}m" if not days else ""]
    return " ".join(p for p in parts if p) or "<1m"


def bar(percent, width=20):
    if percent is None:
        return "?" * width
    filled = max(0, min(width, round(width * percent / 100)))
    return "#" * filled + "." * (width - filled)


def window_line(w, label_width):
    if w["limit_dollars"] is not None:
        left = f"${w['limit_dollars'] - w['used_dollars']:.2f} left"
    elif w["remaining_percent"] is None:
        left = "?"
    else:
        left = f"{w['remaining_percent']:>3.0f}% left"
    when = parse_time(w["resets_at"])
    resets = f"resets in {humanize_until(when)}" if when else "no reset reported"
    return f"  {w['label']:<{label_width}} [{bar(w['used_percent'])}] {left:>9}  {resets}"


def provider_lines(name, result, spin, label_width):
    """One provider's block -- a spinner while its answer is still in flight."""
    if result is None:
        return [name, f"  {spin} checking"]
    tags = [t for t in (result.get("plan"), result.get("status")) if t]
    header = name + (f"  [{', '.join(tags)}]" if tags else "")
    if not result["ok"]:
        return [header, f"  unavailable: {result['error']}"]
    if not result["windows"]:
        return [header, "  no quota windows reported"]
    return [header] + [window_line(w, label_width) for w in result["windows"]]


def render(names, results, spin=" ", hint=None):
    """Every provider's block, blank-line separated, as a list of lines."""
    # One column width for every provider, so the bars line up down the page
    # however long a vendor decides to make its window names.
    label_width = max([20] + [len(w["label"]) for r in results.values() for w in r["windows"]])

    lines = []
    for name in names:
        if lines:
            lines.append("")
        lines.extend(provider_lines(name, results.get(name), spin, label_width))
    if hint:
        lines.extend(["", hint])
    return lines


# --- providers --------------------------------------------------------------

PROVIDERS = [
    ("Claude Code", claude_usage),
    ("Codex", codex_usage),
    ("Cursor", cursor_usage),
]


def run_provider(name, fn):
    try:
        data = fn()
        return {"provider": name, "ok": True, "plan": data["plan"],
                "status": data.get("status"),
                "windows": [w.as_dict() for w in data["windows"]]}
    # Three undocumented endpoints, so one provider going down -- expected, or
    # through a parsing bug of ours -- must not take the other two with it. A
    # bug still reads as one, because its exception is named in the message.
    except Exception as e:  # noqa: BLE001
        detail = str(e) if isinstance(e, Unavailable) else f"{type(e).__name__}: {e}"
        return {"provider": name, "ok": False, "error": detail, "windows": []}


FRAME_SECONDS = 0.1  # how often an animating caller wants to redraw


def collect(providers, on_tick=None):
    """Query every provider at once, filling results in as each one answers.

    `on_tick` is called with what has arrived so far, both on every answer and
    on a timer, so a caller animating a spinner has something to redraw.
    """
    results = {}
    # Deliberately not the `with` form: it joins the threads on the way out, so
    # Ctrl-C during a stalled request would hang here instead of unwinding.
    pool = futures.ThreadPoolExecutor(max_workers=len(providers))
    try:
        pending = {pool.submit(run_provider, name, fn): name for name, fn in providers}
        while pending:
            done, _ = futures.wait(pending, timeout=FRAME_SECONDS if on_tick else None)
            for future in done:
                name = pending.pop(future)
                results[name] = future.result()
            if on_tick:
                on_tick(results)
    finally:
        pool.shutdown(wait=False)
    return results


# --- live output ------------------------------------------------------------

class Live:
    """Repaints a block of lines in place, hiding the cursor while it does.

    Stops repainting once the block outgrows the window, where counting lines
    back up would fight the terminal's own scrolling; `finish` then prints the
    finished block plainly, so a caller need not know which way it went.
    """

    def __init__(self, out):
        self.out = out
        self.painted = 0
        self.shown = None
        self.on = True

    def __enter__(self):
        self.out.write("\033[?25l")  # or the cursor flickers over the spinner
        return self

    def __exit__(self, *exc_info):
        self.out.write("\033[?25h")
        self.out.flush()

    def paint(self, lines):
        if not self.on or lines == self.shown:
            return
        size = shutil.get_terminal_size()  # a pty may report no size at all
        rows, cols = size.lines or 24, size.columns or 80
        if len(lines) >= rows:
            self.erase()
            self.on = False
            return
        self.erase()
        # Clip rather than let the terminal wrap: a wrapped line costs two rows
        # and the rewind above would then land in the middle of the block.
        self.out.write("\n".join(line[:cols] for line in lines) + "\n")
        self.out.flush()
        self.painted, self.shown = len(lines), lines

    def erase(self):
        if self.painted:
            self.out.write(f"\033[{self.painted}A\033[J")
            self.out.flush()
            self.painted, self.shown = 0, None

    def finish(self, lines):
        self.paint(lines)
        if not self.on:
            self.out.write("\n".join(lines) + "\n")
            self.out.flush()


def show_live(providers, out, hint=None):
    """Draw the block immediately, then fill each provider in as it answers."""
    names = [name for name, _ in providers]
    with Live(out) as live:
        return paint_collect(providers, names, live, hint=hint)


def wait_for_reload(seconds):
    """Sleep up to `seconds`, returning True if the user pressed r sooner."""
    deadline = time.monotonic() + seconds
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        ready, _, _ = select.select([sys.stdin], [], [], min(remaining, 0.25))
        if not ready:
            continue
        # Drain the whole burst so a held key does not fire the next wait too.
        hit = False
        while select.select([sys.stdin], [], [], 0)[0]:
            if sys.stdin.read(1) in ("r", "R"):
                hit = True
        if hit:
            return True


def paint_collect(providers, names, live, hint=None):
    """One poll cycle: spinner in, each provider filled as it answers."""
    spinner = itertools.cycle(SPINNER)
    live.paint(render(names, {}, next(spinner), hint=hint))
    results = collect(
        providers,
        lambda r: live.paint(render(names, r, next(spinner), hint=hint)),
    )
    live.finish(render(names, results, hint=hint))
    return results


def show_stream(providers, out):
    """Keep redrawing: auto-refresh every STREAM_SECONDS, or sooner on 'r'."""
    if not (sys.stdin.isatty() and out.isatty()):
        raise SystemExit("live mode needs an interactive terminal")

    names = [name for name, _ in providers]
    hint = "Reload [r]"
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)  # one key at a time, Ctrl-C still interrupts
        with Live(out) as live:
            while True:
                # finish() may have given up on a tiny window; re-enable so the
                # next poll can try in-place redraw again after a resize.
                live.on = True
                paint_collect(providers, names, live, hint=hint)
                wait_for_reload(STREAM_SECONDS)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("mode", nargs="?", choices=["live"],
                    help="keep refreshing on a timer; press r to reload now")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--only", nargs="+", metavar="PROVIDER",
                    help="limit to claude, codex and/or cursor")
    args = ap.parse_args()

    if args.mode == "live" and args.json:
        ap.error("--json cannot be used with live mode")

    only = {p.lower() for p in args.only} if args.only else None
    providers = [(n, fn) for n, fn in PROVIDERS if not only or n.lower().split()[0] in only]
    if not providers:
        ap.error("unknown provider -- choose from claude, codex, cursor")

    names = [name for name, _ in providers]
    if args.mode == "live":
        show_stream(providers, sys.stdout)
        return 0  # reached only if the loop ever grows an exit
    if args.json:
        results = collect(providers)
        print(json.dumps([results[n] for n in names], indent=2))
    elif sys.stdout.isatty():
        results = show_live(providers, sys.stdout)
    else:
        results = collect(providers)
        print("\n".join(render(names, results)))
    return 0 if any(r["ok"] for r in results.values()) else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # A normal exit would wait for the in-flight requests to time out, so
        # leave now -- there is nothing here worth flushing but stdout.
        sys.stdout.flush()
        os._exit(130)
