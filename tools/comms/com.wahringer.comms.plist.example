<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wahringer.comms</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>run</string>
    <string>/Users/minj/Projects/agents/tools/comms/server.js</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/minj/Projects/agents/tools/comms</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key><string>3775</string>
    <key>POSTPLAN_PUBLIC_BASE_URL</key><string>https://minj.tail794979.ts.net:8774</string>
    <key>POSTPLAN_DATA_DIR</key><string>/Users/minj/.local/share/comms</string>
    <key>POSTPLAN_BOOTSTRAP_API_KEY</key><string>replace-me</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- If the server exits at once (bad config, port taken), wait 10s before
       retrying instead of spinning. launchd's own floor is 10s anyway. -->
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/minj/.local/share/comms/comms.log</string>
  <key>StandardErrorPath</key><string>/Users/minj/.local/share/comms/comms.log</string>
</dict>
</plist>
